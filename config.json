{
  "role": "uav1",
  "active_profile": "simulation",
  "flight_enabled": false,
  "profiles": {
    "simulation": {
      "platform": "simulation",
      "uav1": {
        "home": {"x": 0.0, "y": 0.0},
        "station": {"x": -1.0, "y": 0.0}
      },
      "uav2": {
        "home": {"x": 0.0, "y": 0.0},
        "cargo": {"x": -1.0, "y": 0.0},
        "station": {"x": -2.0, "y": 0.0}
      }
    },
    "field": {
      "platform": "clover5",
      "markers": {
        "cargo": 0,
        "station_1": 5,
        "station_2": 37,
        "uav1_home": 48,
        "uav2_home": 27
      },
      "uav1": {
        "home": {"x": 6.0, "y": 0.0},
        "station": {"x": 5.0, "y": 6.0}
      },
      "uav2": {
        "home": {"x": 6.0, "y": 3.0},
        "cargo": {"x": 0.0, "y": 6.0},
        "station": {"x": 2.0, "y": 1.0}
      }
    }
  },
  "navigation": {
    "frame_id": "map",
    "altitude": 1.2,
    "speed": 0.35,
    "navigation_timeout": 45.0,
    "localization_timeout": 15.0,
    "startup_timeout": 20.0,
    "landing_timeout": 35.0,
    "takeoff_hold": 2.0
  },
  "timing": {
    "charge_seconds": 15.0,
    "green_before_takeoff_seconds": 5.0,
    "gripper_settle_seconds": 1.0
  },
  "gates": {
    "start": {
      "mode": "udp",
      "event": "START",
      "timeout": 300.0
    },
    "station_invitation": {
      "mode": "udp",
      "event": "LAND_GRANTED",
      "timeout": 120.0
    },
    "uav1_return": {
      "mode": "udp",
      "event": "RETURN_HOME",
      "timeout": 300.0
    },
    "uav2_depart": {
      "mode": "udp",
      "event": "UAV2_DEPART",
      "timeout": 300.0
    }
  },
  "network": {
    "listen_ip": "0.0.0.0",
    "event_port": 45900,
    "station_ip": "",
    "station_port": 45901,
    "uav1_ip": "",
    "uav2_ip": ""
  },
  "led": {
    "required_before_takeoff": false,
    "brightness": 1.0,
    "blink_period": 0.5
  },
  "gripper": {
    "enabled": true,
    "required": true,
    "gpio": {
      "bcm_pin": 18,
      "pin_factory": "lgpio",
      "open_value": -1.0,
      "closed_value": 1.0,
      "min_pulse_width": 0.0005,
      "max_pulse_width": 0.0025
    },
    "gazebo": {
      "topic": "/model/px4/command/gripper",
      "open_position": 0.0,
      "closed_position": -0.9
    }
  },
  "logging": {
    "directory": "logs"
  }
